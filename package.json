{
  "name": "apexcharts-mcp",
  "version": "0.9.1",
  "mcpName": "com.apexcharts/mcp",
  "description": "Model Context Protocol server exposing the ApexCharts ecosystem (charts, gantt, tree, sankey, grid, stock, maps) as tools for AI assistants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexcharts/apexcharts-mcp.git"
  },
  "type": "module",
  "bin": {
    "apexcharts-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:versions": "node scripts/check-versions.mjs",
    "check:chart-types": "node scripts/check-chart-types.mjs",
    "check:surface-delta": "node scripts/check-surface-delta.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apexcharts",
    "apexgantt",
    "apextree",
    "apexsankey",
    "apex-grid",
    "apexstock",
    "apexmaps",
    "charts",
    "gantt",
    "stock",
    "maps",
    "data-visualization",
    "ai",
    "claude"
  ],
  "author": "ApexCharts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "hono": "^4.13.13",
    "proxy-addr": "^2.0.8",
    "qs": "^6.15.4",
    "ip-address": "^10.7.1",
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "apexcharts-skill": "^3.1.0",
    "apexgantt-skill": "^1.5.1",
    "apexgrid-skill": "^2.3.1",
    "apexmaps-skill": "^1.1.0",
    "apexsankey-skill": "^1.4.1",
    "apexstock-skill": "^2.0.1",
    "apextree-skill": "^1.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
